{
  "name": "proxmox-services-homepage",
  "version": "0.7.0",
  "description": "Proxmox LXC container service dashboard",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "build": "bun build static/js/app.js --outfile static/js/bundle.js --minify",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "1.3.14",
    "typescript": "^7.0.0"
  }
}
